<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/titleView"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/white"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dp30" />
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dp50">
            <TextView
                android:textSize="@dimen/sp17"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bulletin"
                android:layout_centerInParent="true" />
            <ImageView
                android:id="@id/backImg"
                android:layout_width="@dimen/dp24"
                android:layout_height="@dimen/dp24"
                android:src="@mipmap/back"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp16"
                android:layout_alignParentStart="true" />
        </RelativeLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp18"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:id="@id/titleTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp14" />
            <TextView
                android:textSize="@dimen/sp14"
                android:textStyle="bold"
                android:textColor="#ff505377"
                android:id="@id/timeTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10" />
            <TextView
                android:textSize="@dimen/sp16"
                android:textStyle="bold"
                android:textColor="#ff010101"
                android:gravity="start"
                android:id="@id/contentTxt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp17"
                android:layout_marginTop="@dimen/dp14"
                android:layout_marginRight="@dimen/dp17"
                android:layout_marginBottom="@dimen/dp14"
                android:lineSpacingExtra="@dimen/dp5"
                android:layout_marginHorizontal="@dimen/dp17"
                android:layout_marginVertical="@dimen/dp14" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>