<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/bigLin"
    android:background="@color/CoF2F5FA"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingHorizontal="@dimen/dp16"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.core.widget.NestedScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp100"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <TextView
                android:textSize="@dimen/sp18"
                android:textStyle="bold"
                android:textColor="#ff010101"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginBottom="@dimen/dp12"
                android:text="@string/network" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:weightSum="1.0">
                <RelativeLayout
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/dp58"
                    android:layout_weight="1.0">
                    <RelativeLayout
                        android:background="@drawable/bgdp9_stroke_main"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/dp58"
                        android:layout_alignParentBottom="true">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/dp20">
                            <ImageView
                                android:layout_width="@dimen/dp33"
                                android:layout_height="@dimen/dp33"
                                android:src="@mipmap/usdt_img"
                                android:layout_marginEnd="@dimen/dp10" />
                            <TextView
                                android:textSize="@dimen/sp18"
                                android:textStyle="bold"
                                android:textColor="#ff010101"
                                android:id="@id/nameTxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TRC20" />
                        </LinearLayout>
                    </RelativeLayout>
                    <ImageView
                        android:visibility="invisible"
                        android:layout_width="@dimen/dp35"
                        android:layout_height="@dimen/dp35"
                        android:src="@mipmap/x_red"
                        android:scaleType="fitXY"
                        android:layout_marginEnd="@dimen/dp5"
                        android:layout_alignParentEnd="true" />
                    <ImageView
                        android:layout_width="@dimen/dp18"
                        android:layout_height="@dimen/dp18"
                        android:src="@mipmap/dui_a"
                        android:scaleType="fitXY"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/dp18"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <TextView
                    android:textSize="@dimen/sp13"
                    android:textStyle="bold"
                    android:textColor="#ffff0000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• " />
                <TextView
                    android:textSize="@dimen/sp13"
                    android:textStyle="bold"
                    android:textColor="#ff010101"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Only accept TRC20 network" />
            </LinearLayout>
            <TextView
                android:textSize="@dimen/sp18"
                android:textStyle="bold"
                android:textColor="#ff010101"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20"
                android:layout_marginBottom="@dimen/dp12"
                android:text="@string/you_transfer" />
            <RelativeLayout
                android:id="@id/fromView"
                android:background="@drawable/bgdp10_de"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/dp52"
                android:paddingStart="@dimen/dp20"
                android:paddingEnd="@dimen/dp13">
                <EditText
                    android:textSize="@dimen/sp16"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textColorHint="#ff777777"
                    android:id="@id/bCountEt"
                    android:background="@null"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/dp52"
                    android:hint="@string/please_enter_the_number"
                    android:singleLine="true"
                    android:maxLength="5"
                    android:inputType="number"
                    android:textCursorDrawable="@drawable/bgcursor" />
                <TextView
                    android:textSize="@dimen/sp18"
                    android:textStyle="bold"
                    android:textColor="#ff010101"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USDT"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/sp13"
                android:textStyle="bold"
                android:textColor="#ff010101"
                android:id="@id/tranTxt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:text="@string/tran_s"
                android:lineSpacingExtra="@dimen/dp6" />
            <TextView
                android:textSize="@dimen/sp18"
                android:textStyle="bold"
                android:textColor="#ff010101"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20"
                android:layout_marginBottom="@dimen/dp12"
                android:text="@string/you_deposit" />
            <RelativeLayout
                android:background="@drawable/bgdp10_de"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/dp52"
                android:paddingStart="@dimen/dp20"
                android:paddingEnd="@dimen/dp13">
                <TextView
                    android:textSize="@dimen/sp16"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center_vertical"
                    android:id="@id/actualTxt"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/dp52"
                    android:singleLine="true"
                    android:maxLength="50" />
                <ImageView
                    android:layout_width="@dimen/dp40"
                    android:layout_height="@dimen/dp40"
                    android:src="@mipmap/coinb"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/sp14"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@id/nextTxt"
                android:background="@drawable/bgdp6_comain"
                android:paddingTop="@dimen/dp14"
                android:paddingBottom="@dimen/dp14"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                android:foreground="?android:selectableItemBackground"
                android:text="@string/next"
                android:paddingVertical="@dimen/dp14" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>