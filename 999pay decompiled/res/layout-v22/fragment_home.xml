<?xml version="1.0" encoding="utf-8"?>
<com.scwang.smart.refresh.layout.SmartRefreshLayout
    android:orientation="vertical"
    android:id="@id/refreshLayout"
    android:background="@drawable/bgjianbianhome"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.scwang.smart.refresh.header.ClassicsHeader
        android:id="@id/headerView"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        app:srlAccentColor="@color/black"
        app:srlPrimaryColor="@color/transparent"
        app:srlTextSizeTime="@dimen/sp15"
        app:srlTextSizeTitle="@dimen/sp17" />
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.amar.library.ui.StickyScrollView
            android:id="@id/nestedView1"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:overScrollMode="never">
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/dp160"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@id/inviteImg"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/dp150"
                        android:layout_marginLeft="@dimen/dp15"
                        android:layout_marginRight="@dimen/dp15"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        android:layout_marginHorizontal="@dimen/dp15" />
                    <com.zhpan.bannerview.BannerViewPager
                        android:id="@id/banner_view"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/dp155"
                        android:layout_marginLeft="@dimen/dp15"
                        android:layout_marginTop="@dimen/dp45"
                        android:layout_marginRight="@dimen/dp15"
                        android:layout_marginHorizontal="@dimen/dp15"
                        app:bvp_indicator_checked_color="@color/white"
                        app:bvp_indicator_normal_color="@color/Coffffff_60"
                        app:bvp_indicator_radius="@dimen/dp5"
                        app:bvp_indicator_slide_mode="worm"
                        app:bvp_page_margin="@dimen/dp12"
                        app:bvp_page_style="multi_page_scale"
                        app:bvp_round_corner="@dimen/dp0"
                        app:bvp_scroll_duration="700" />
                    <RelativeLayout
                        android:id="@id/SellView"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingRight="@dimen/dp16"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp20"
                        android:layout_marginBottom="@dimen/dp15"
                        android:paddingHorizontal="@dimen/dp16">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="@dimen/dp20"
                                android:layout_height="@dimen/dp20"
                                android:src="@mipmap/star"
                                android:scaleType="fitXY"
                                android:layout_marginEnd="@dimen/dp10" />
                            <TextView
                                android:textSize="@dimen/sp17"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Selling"
                                android:layout_marginEnd="@dimen/dp10" />
                            <TextView
                                android:textSize="@dimen/sp12"
                                android:textStyle="bold"
                                android:textColor="#ff959595"
                                android:id="@id/msTxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(Closed)" />
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true">
                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <com.india.cnm.view.SwitchButton
                                    android:id="@id/switchBtn"
                                    android:layout_width="@dimen/dp50"
                                    android:layout_height="@dimen/dp26"
                                    app:sb_background="#ff8e8e8e"
                                    app:sb_button_color="@color/white"
                                    app:sb_checked="false"
                                    app:sb_checked_color="#ff028e18"
                                    app:sb_show_indicator="false" />
                                <View
                                    android:id="@id/onView"
                                    android:layout_width="@dimen/dp50"
                                    android:layout_height="@dimen/dp26" />
                            </RelativeLayout>
                        </LinearLayout>
                    </RelativeLayout>
                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp15"
                        android:layout_marginRight="@dimen/dp15"
                        android:layout_marginHorizontal="@dimen/dp15">
                        <LinearLayout
                            android:gravity="start|center"
                            android:orientation="horizontal"
                            android:background="@drawable/bgdp6b"
                            android:paddingTop="@dimen/dp8"
                            android:paddingBottom="@dimen/dp8"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:paddingStart="@dimen/dp14"
                            android:layout_marginEnd="@dimen/dp12"
                            android:paddingVertical="@dimen/dp8">
                            <ImageView
                                android:layout_width="@dimen/dp28"
                                android:layout_height="@dimen/dp28"
                                android:src="@mipmap/p_l"
                                android:layout_marginEnd="@dimen/dp9" />
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/sp15"
                                    android:textStyle="bold"
                                    android:textColor="#ff000000"
                                    android:id="@id/tpTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                                <TextView
                                    android:textSize="@dimen/sp12"
                                    android:textStyle="bold"
                                    android:textColor="#ff959595"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Today Purchase" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="start|center"
                            android:orientation="horizontal"
                            android:background="@drawable/bgdp6b"
                            android:paddingTop="@dimen/dp8"
                            android:paddingBottom="@dimen/dp8"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:paddingStart="@dimen/dp14"
                            android:paddingVertical="@dimen/dp8">
                            <ImageView
                                android:layout_width="@dimen/dp28"
                                android:layout_height="@dimen/dp28"
                                android:src="@mipmap/p_r"
                                android:layout_marginEnd="@dimen/dp9" />
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/sp15"
                                    android:textStyle="bold"
                                    android:textColor="#ff000000"
                                    android:id="@id/tsTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                                <TextView
                                    android:textSize="@dimen/sp12"
                                    android:textStyle="bold"
                                    android:textColor="#ff959595"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Today Sell" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <RelativeLayout
                        android:id="@id/inrView"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingRight="@dimen/dp16"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp20"
                        android:layout_marginBottom="@dimen/dp15"
                        android:paddingHorizontal="@dimen/dp16">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="@dimen/dp20"
                                android:layout_height="@dimen/dp20"
                                android:src="@mipmap/star"
                                android:scaleType="fitXY"
                                android:layout_marginEnd="@dimen/dp10" />
                            <TextView
                                android:textSize="@dimen/sp17"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Purchase with Rupee" />
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true">
                            <TextView
                                android:textSize="@dimen/sp14"
                                android:textStyle="bold"
                                android:textColor="@color/CoMainA"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/go_now"
                                android:layout_marginEnd="@dimen/dp2" />
                        </LinearLayout>
                    </RelativeLayout>
                    <RelativeLayout
                        android:background="@drawable/bgdp12n"
                        android:paddingLeft="@dimen/dp14"
                        android:paddingTop="@dimen/dp8"
                        android:paddingRight="@dimen/dp14"
                        android:paddingBottom="@dimen/dp8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginHorizontal="@dimen/dp16"
                        android:paddingHorizontal="@dimen/dp14"
                        android:paddingVertical="@dimen/dp8">
                        <ImageView
                            android:id="@id/lImg"
                            android:layout_width="@dimen/dp32"
                            android:layout_height="@dimen/dp32"
                            android:src="@mipmap/k_l"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/dp15"
                            android:layout_alignParentStart="true" />
                        <TextView
                            android:textSize="@dimen/sp19"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:id="@id/newRadioTxt"
                            android:layout_width="fill_parent"
                            android:layout_height="@dimen/dp40"
                            android:lines="1"
                            android:singleLine="true"
                            android:layout_centerInParent="true"
                            android:layout_toEndOf="@id/lImg"
                            android:autoSizeTextType="uniform"
                            android:autoSizeStepGranularity="@dimen/sp1"
                            android:autoSizeMinTextSize="@dimen/sp4"
                            android:autoSizeMaxTextSize="@dimen/sp25" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@id/usdtView"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingRight="@dimen/dp16"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp24"
                        android:layout_marginBottom="@dimen/dp15"
                        android:paddingHorizontal="@dimen/dp16">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="@dimen/dp20"
                                android:layout_height="@dimen/dp20"
                                android:src="@mipmap/star"
                                android:scaleType="fitXY"
                                android:layout_marginEnd="@dimen/dp10" />
                            <TextView
                                android:textSize="@dimen/sp17"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Purchase with USDT" />
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true">
                            <TextView
                                android:textSize="@dimen/sp14"
                                android:textStyle="bold"
                                android:textColor="@color/CoMainA"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/go_now"
                                android:layout_marginEnd="@dimen/dp2" />
                        </LinearLayout>
                    </RelativeLayout>
                    <RelativeLayout
                        android:background="@drawable/bgdp12g"
                        android:padding="@dimen/dp14"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp15"
                        android:layout_marginRight="@dimen/dp15"
                        android:layout_marginHorizontal="@dimen/dp15">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/sp25"
                                    android:textStyle="bold"
                                    android:textColor="#ff000000"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Our Price "
                                    android:lines="1"
                                    android:singleLine="true"
                                    android:autoSizeTextType="uniform"
                                    android:autoSizeStepGranularity="@dimen/sp1"
                                    android:autoSizeMinTextSize="@dimen/sp4"
                                    android:autoSizeMaxTextSize="@dimen/sp25" />
                                <TextView
                                    android:textSize="@dimen/sp25"
                                    android:textStyle="bold"
                                    android:textColor="#ff9e7f38"
                                    android:id="@id/ourTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp8">
                                <TextView
                                    android:textSize="@dimen/sp14"
                                    android:textStyle="bold"
                                    android:textColor="#80010101"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Market Price "
                                    android:lines="1"
                                    android:singleLine="true"
                                    android:autoSizeTextType="uniform"
                                    android:autoSizeStepGranularity="@dimen/sp1"
                                    android:autoSizeMinTextSize="@dimen/sp4"
                                    android:autoSizeMaxTextSize="@dimen/sp25" />
                                <TextView
                                    android:textSize="@dimen/sp14"
                                    android:textStyle="bold"
                                    android:textColor="#80010101"
                                    android:id="@id/marketTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/dunimg"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/learnMoreView"
                        android:paddingLeft="@dimen/dp15"
                        android:paddingTop="@dimen/dp11"
                        android:paddingRight="@dimen/dp15"
                        android:paddingBottom="@dimen/dp11"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp2"
                        android:paddingHorizontal="@dimen/dp15"
                        android:paddingVertical="@dimen/dp11">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="@dimen/dp20"
                                android:layout_height="@dimen/dp20"
                                android:src="@mipmap/star"
                                android:scaleType="fitXY"
                                android:layout_marginEnd="@dimen/dp10" />
                            <TextView
                                android:textSize="@dimen/sp17"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tutorial" />
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textStyle="bold"
                            android:textColor="@color/CoMainA"
                            android:gravity="end"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/learn_more"
                            android:layout_weight="1.0" />
                    </LinearLayout>
                    <HorizontalScrollView
                        android:visibility="gone"
                        android:scrollbars="none"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:clipToPadding="false"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/dp12"
                            android:paddingEnd="@dimen/dp12">
                            <ImageView
                                android:id="@id/jMobImg"
                                android:layout_width="@dimen/dp167"
                                android:layout_height="@dimen/dp49"
                                android:src="@mipmap/k_mob"
                                android:scaleType="fitXY"
                                android:layout_weight="1.0" />
                            <ImageView
                                android:id="@id/jFreeImg"
                                android:layout_width="@dimen/dp167"
                                android:layout_height="@dimen/dp49"
                                android:src="@mipmap/k_free"
                                android:scaleType="fitXY"
                                android:layout_weight="1.0"
                                android:layout_marginStart="@dimen/dp12" />
                            <ImageView
                                android:id="@id/jPhoneImg"
                                android:layout_width="@dimen/dp167"
                                android:layout_height="@dimen/dp49"
                                android:src="@mipmap/k_phone"
                                android:scaleType="fitXY"
                                android:layout_weight="1.0"
                                android:layout_marginStart="@dimen/dp12" />
                            <ImageView
                                android:id="@id/jPaytmImg"
                                android:layout_width="@dimen/dp167"
                                android:layout_height="@dimen/dp49"
                                android:src="@mipmap/k_paytm"
                                android:scaleType="fitXY"
                                android:layout_weight="1.0"
                                android:layout_marginStart="@dimen/dp12" />
                        </LinearLayout>
                    </HorizontalScrollView>
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="vertical"
                        android:id="@id/rvd5"
                        android:paddingBottom="@dimen/dp50"
                        android:visibility="visible"
                        android:clipToPadding="false"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>
            </RelativeLayout>
        </com.amar.library.ui.StickyScrollView>
        <ImageView
            android:id="@id/rightImg"
            android:layout_width="@dimen/dp54"
            android:layout_height="@dimen/dp54"
            android:layout_marginBottom="@dimen/dp200"
            android:src="@mipmap/service_rr"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/dp5"
            android:layout_alignParentEnd="true" />
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/bgdp7w"
            android:paddingLeft="@dimen/dp22"
            android:paddingTop="@dimen/dp4"
            android:paddingRight="@dimen/dp22"
            android:paddingBottom="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp80"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:paddingHorizontal="@dimen/dp22"
            android:paddingVertical="@dimen/dp4">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/safe_img" />
            <TextView
                android:textSize="@dimen/sp13"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:id="@id/safeTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_marginStart="@dimen/dp4"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="@dimen/sp1"
                android:autoSizeMinTextSize="@dimen/sp4"
                android:autoSizeMaxTextSize="@dimen/sp14" />
        </LinearLayout>
    </RelativeLayout>
</com.scwang.smart.refresh.layout.SmartRefreshLayout>