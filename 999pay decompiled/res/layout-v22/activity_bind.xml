<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/titleView"
        android:background="@color/white"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dp50"
            android:layout_marginTop="@dimen/dp30"
            android:paddingStart="@dimen/dp16">
            <TextView
                android:textSize="@dimen/sp17"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bind_email"
                android:layout_centerInParent="true" />
            <ImageView
                android:id="@id/backImg"
                android:layout_width="@dimen/dp24"
                android:layout_height="@dimen/dp24"
                android:src="@mipmap/back"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true" />
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp22"
        android:paddingRight="@dimen/dp16"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp16">
        <TextView
            android:textSize="@dimen/sp16"
            android:textStyle="bold"
            android:textColor="#ff333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp10"
            android:text="@string/email_address" />
        <EditText
            android:textSize="@dimen/sp16"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textColorHint="#ff777777"
            android:id="@id/emailEt"
            android:background="@drawable/bgdp6_bind"
            android:paddingLeft="@dimen/dp10"
            android:paddingRight="@dimen/dp10"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dp50"
            android:hint="@string/email_address"
            android:singleLine="true"
            android:maxLength="50"
            android:inputType="textEmailAddress"
            android:textCursorDrawable="@drawable/bgcursor"
            android:paddingHorizontal="@dimen/dp10" />
        <TextView
            android:textSize="@dimen/sp16"
            android:textStyle="bold"
            android:textColor="#ff333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp26"
            android:layout_marginBottom="@dimen/dp10"
            android:text="@string/otp" />
        <RelativeLayout
            android:background="@drawable/bgdp6_bind"
            android:paddingLeft="@dimen/dp10"
            android:paddingRight="@dimen/dp10"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dp50"
            android:paddingHorizontal="@dimen/dp10">
            <EditText
                android:textSize="@dimen/sp16"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textColorHint="#ff777777"
                android:id="@id/otpET"
                android:background="@null"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/dp50"
                android:hint="@string/received_from_email"
                android:singleLine="true"
                android:maxLength="6"
                android:inputType="number"
                android:textCursorDrawable="@drawable/bgcursor" />
            <TextView
                android:textSize="@dimen/sp14"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:id="@id/getOtpTxt"
                android:background="@drawable/bgdp4main"
                android:paddingLeft="@dimen/dp12"
                android:paddingTop="@dimen/dp5"
                android:paddingRight="@dimen/dp12"
                android:paddingBottom="@dimen/dp5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/send"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="@dimen/dp12"
                android:paddingVertical="@dimen/dp5" />
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/sp16"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/bindTxt"
            android:background="@drawable/bgdp8main"
            android:paddingTop="@dimen/dp16"
            android:paddingBottom="@dimen/dp16"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp40"
            android:layout_marginBottom="@dimen/dp40"
            android:text="@string/submit"
            android:layout_marginVertical="@dimen/dp40"
            android:paddingVertical="@dimen/dp16" />
    </LinearLayout>
</LinearLayout>