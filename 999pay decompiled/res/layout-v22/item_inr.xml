<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@id/conView"
    android:background="@drawable/bgdp12fen"
    android:paddingLeft="@dimen/dp15"
    android:paddingTop="@dimen/dp10"
    android:paddingRight="@dimen/dp15"
    android:paddingBottom="@dimen/dp10"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:selectableItemBackground"
    android:paddingHorizontal="@dimen/dp15"
    android:paddingVertical="@dimen/dp10"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/topView"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/leftImg"
            android:layout_width="@dimen/dp36"
            android:layout_height="@dimen/dp36"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp12" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/leftImg">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/tView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp4">
                <TextView
                    android:textSize="@dimen/sp16"
                    android:textStyle="bold"
                    android:textColor="#ff010101"
                    android:id="@id/orderAmountTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:textSize="@dimen/sp16"
                    android:textStyle="bold"
                    android:textColor="#ff010101"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rs" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp16">
                <TextView
                    android:textSize="@dimen/sp10"
                    android:textStyle="bold"
                    android:textColor="@color/CoMainA"
                    android:id="@id/orderUsesTxt"
                    android:background="@drawable/bgdp4strokemain"
                    android:paddingLeft="@dimen/dp9"
                    android:paddingTop="@dimen/dp2"
                    android:paddingRight="@dimen/dp9"
                    android:paddingBottom="@dimen/dp2"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp5"
                    android:paddingHorizontal="@dimen/dp9"
                    android:paddingVertical="@dimen/dp2" />
                <TextView
                    android:textSize="@dimen/sp10"
                    android:textStyle="bold"
                    android:textColor="#ff128c45"
                    android:id="@id/orderUsesTxt2"
                    android:background="@drawable/bgdp4strokemaing"
                    android:paddingLeft="@dimen/dp9"
                    android:paddingTop="@dimen/dp2"
                    android:paddingRight="@dimen/dp9"
                    android:paddingBottom="@dimen/dp2"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp9"
                    android:paddingVertical="@dimen/dp2" />
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="@dimen/sp14"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/buyTxt"
                android:background="@drawable/bgdp4inr"
                android:paddingLeft="@dimen/dp21"
                android:paddingTop="@dimen/dp6"
                android:paddingRight="@dimen/dp21"
                android:paddingBottom="@dimen/dp6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buy"
                android:paddingHorizontal="@dimen/dp21"
                android:paddingVertical="@dimen/dp6" />
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp17"
        android:weightSum="2.0"
        android:layout_below="@id/topView">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <TextView
                android:textSize="@dimen/sp11"
                android:textStyle="bold"
                android:textColor="#ff505377"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reward" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp1">
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textStyle="bold"
                    android:textColor="#ff010101"
                    android:id="@id/rewardTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <ImageView
                    android:layout_width="@dimen/dp22"
                    android:layout_height="@dimen/dp22"
                    android:src="@mipmap/zuan"
                    android:layout_marginStart="@dimen/dp8"
                    android:layout_marginEnd="@dimen/dp6" />
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textStyle="bold"
                    android:textColor="#ff010101"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(" />
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textStyle="bold"
                    android:textColor="#ff010101"
                    android:id="@id/returnRatioTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textStyle="bold"
                    android:textColor="#ff010101"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%" />
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textStyle="bold"
                    android:textColor="#ffff0000"
                    android:id="@id/jTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+" />
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textStyle="bold"
                    android:textColor="#ffff0000"
                    android:id="@id/returnAmountTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textStyle="bold"
                    android:textColor="#ff010101"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=")" />
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:gravity="end"
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <TextView
                android:textSize="@dimen/sp11"
                android:textStyle="bold"
                android:textColor="#ff505377"
                android:id="@id/inTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diamond"
                android:layout_marginEnd="@dimen/dp59" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp1"
                android:layout_below="@id/inTxt"
                android:layout_alignStart="@id/inTxt">
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textStyle="bold"
                    android:textColor="#ff010101"
                    android:id="@id/inCoinTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <ImageView
                    android:layout_width="@dimen/dp22"
                    android:layout_height="@dimen/dp22"
                    android:src="@mipmap/zuan"
                    android:layout_marginStart="@dimen/dp8"
                    android:layout_marginEnd="@dimen/dp6" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>