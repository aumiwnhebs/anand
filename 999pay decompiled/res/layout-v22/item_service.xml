<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:selectableItemBackground"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/serviceRl"
        android:paddingLeft="@dimen/dp12"
        android:paddingTop="@dimen/dp28"
        android:paddingRight="@dimen/dp12"
        android:paddingBottom="@dimen/dp28"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp12"
        android:paddingVertical="@dimen/dp28">
        <ImageView
            android:id="@id/changImg"
            android:layout_width="@dimen/dp48"
            android:layout_height="@dimen/dp48"
            android:layout_marginEnd="@dimen/dp8" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/changImg">
            <TextView
                android:textSize="@dimen/sp16"
                android:textStyle="bold"
                android:textColor="#ff333333"
                android:id="@id/nameTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:textSize="@dimen/sp16"
                android:textColor="#ff777777"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp5"
                android:text="@string/online" />
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp14"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:id="@id/contactTxt"
            android:background="@drawable/bgdp8main"
            android:padding="@dimen/dp8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contact"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <View
        android:id="@id/lineView"
        android:background="#ffe4e8ee"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/dp1" />
</LinearLayout>