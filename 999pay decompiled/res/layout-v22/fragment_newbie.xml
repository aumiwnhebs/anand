<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/bigLin"
    android:background="@color/CoF2F5FA"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingHorizontal="@dimen/dp16"
    android:paddingVertical="@dimen/dp16"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:background="@mipmap/bg_new1"
        android:paddingLeft="@dimen/dp12"
        android:paddingTop="@dimen/dp16"
        android:paddingRight="@dimen/dp12"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp3"
        android:paddingHorizontal="@dimen/dp12"
        android:paddingVertical="@dimen/dp16">
        <ImageView
            android:id="@id/ivZuan"
            android:layout_width="@dimen/dp66"
            android:layout_height="@dimen/dp80"
            android:src="@mipmap/zuan_n"
            android:layout_marginEnd="@dimen/dp8" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/ivZuan">
            <TextView
                android:textSize="@dimen/sp14"
                android:textStyle="bold"
                android:textColor="#ff777777"
                android:id="@id/titleTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/newbie_bonus_incoin"
                android:layout_alignStart="@id/ivZuan" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp9"
                android:layout_below="@id/titleTxt">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/sp26"
                        android:textStyle="bold"
                        android:textColor="#ff333333"
                        android:id="@id/bounsTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:textSize="@dimen/sp14"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@id/finishTxt"
                        android:background="@drawable/bg_newbie_rectangle"
                        android:layout_width="@dimen/dp64"
                        android:layout_height="@dimen/dp33"
                        android:layout_marginLeft="@dimen/dp10"
                        android:text="Undone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@id/m_refresh"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@id/rv_r_keralabig"
            android:paddingTop="@dimen/dp7"
            android:paddingBottom="@dimen/dp30"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>