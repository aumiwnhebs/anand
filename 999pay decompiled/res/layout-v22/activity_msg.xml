<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:background="@color/CoF2F5FA"
    android:fitsSystemWindows="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/titleView"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <View
            android:background="@color/white"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dp30" />
        <RelativeLayout
            android:background="@drawable/bgdp_bot_12"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dp50">
            <TextView
                android:textSize="@dimen/sp17"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/message"
                android:layout_centerInParent="true" />
            <ImageView
                android:id="@id/backImg"
                android:layout_width="@dimen/dp24"
                android:layout_height="@dimen/dp24"
                android:src="@mipmap/back"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp16"
                android:layout_alignParentStart="true" />
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp26"
        android:layout_above="@id/botView"
        android:paddingHorizontal="@dimen/dp12">
        <RelativeLayout
            android:id="@id/serviceImg"
            android:background="@drawable/bg_round2"
            android:layout_width="@dimen/dp36"
            android:layout_height="@dimen/dp36"
            android:layout_marginEnd="@dimen/dp8">
            <ImageView
                android:layout_width="@dimen/dp36"
                android:layout_height="@dimen/dp36"
                android:src="@mipmap/logo"
                android:scaleType="fitXY"
                android:layout_centerInParent="true" />
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/sp13"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:id="@id/changeTxt"
            android:background="@drawable/bgdp12c"
            android:padding="@dimen/dp10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/serviceImg" />
        <TextView
            android:textSize="@dimen/sp12"
            android:textStyle="bold"
            android:textColor="#ff505377"
            android:id="@id/timeTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp7"
            android:layout_below="@id/changeTxt"
            android:layout_alignStart="@id/changeTxt" />
    </RelativeLayout>
    <LinearLayout
        android:id="@id/botView"
        android:background="@color/white"
        android:padding="@dimen/dp9"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="@dimen/sp13"
            android:textStyle="bold"
            android:textColor="#ff010101"
            android:id="@id/sendView"
            android:background="@drawable/bgdp6_bind"
            android:paddingLeft="@dimen/dp14"
            android:paddingTop="@dimen/dp8"
            android:paddingRight="@dimen/dp14"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/please_send_message_from_your_telegram_if_you_need"
            android:paddingHorizontal="@dimen/dp14"
            android:paddingVertical="@dimen/dp8" />
    </LinearLayout>
</RelativeLayout>