<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/conRel"
    android:fitsSystemWindows="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:src="@mipmap/flogin_bg"
        android:scaleType="fitXY" />
    <androidx.core.widget.NestedScrollView
        android:id="@id/nestedView"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp100"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@id/logoImg"
                android:layout_width="@dimen/dp100"
                android:layout_height="@dimen/dp100"
                android:layout_marginTop="@dimen/dp60"
                android:layout_marginBottom="@dimen/dp30"
                android:src="@mipmap/logo"
                android:scaleType="fitXY" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp15"
                    android:layout_marginRight="@dimen/dp15">
                    <com.lihang.ShadowLayout
                        android:layout_gravity="center"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp6"
                        android:layout_marginTop="@dimen/dp24"
                        android:layout_marginRight="@dimen/dp6"
                        app:hl_cornerRadius="@dimen/dp12"
                        app:hl_layoutBackground="@color/white"
                        app:hl_shadowColor="#54000000"
                        app:hl_shadowHiddenTop="true"
                        app:hl_shadowLimit="@dimen/dp6"
                        app:hl_shadowOffsetY="@dimen/dp3"
                        app:hl_strokeColor="#ff000000">
                        <RelativeLayout
                            android:paddingLeft="@dimen/dp5"
                            android:paddingRight="@dimen/dp5"
                            android:layout_width="fill_parent"
                            android:layout_height="@dimen/dp45">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:id="@id/leftLinPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true">
                                <ImageView
                                    android:layout_width="@dimen/dp40"
                                    android:layout_height="@dimen/dp40"
                                    android:src="@mipmap/f_phone"
                                    android:scaleType="fitXY"
                                    android:layout_marginEnd="@dimen/dp9" />
                                <TextView
                                    android:textSize="@dimen/sp16"
                                    android:textStyle="bold"
                                    android:textColor="#ff030f08"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="+91" />
                                <View
                                    android:background="#ff707070"
                                    android:layout_width="@dimen/dp1"
                                    android:layout_height="@dimen/dp25"
                                    android:layout_marginStart="@dimen/dp9"
                                    android:layout_marginEnd="@dimen/dp7" />
                            </LinearLayout>
                            <EditText
                                android:textSize="@dimen/sp15"
                                android:textStyle="bold"
                                android:textColor="@color/CoMainA"
                                android:textColorHint="#ff848484"
                                android:id="@id/phoneEt"
                                android:background="@null"
                                android:paddingLeft="@dimen/dp1"
                                android:layout_width="fill_parent"
                                android:layout_height="@dimen/dp35"
                                android:hint="Phone Number"
                                android:lines="1"
                                android:singleLine="true"
                                android:maxLength="10"
                                android:digits="\ 0123456789"
                                android:layout_toRightOf="@id/leftLinPhone"
                                android:layout_centerVertical="true"
                                android:inputType="phone"
                                android:layout_alignParentEnd="true" />
                        </RelativeLayout>
                    </com.lihang.ShadowLayout>
                    <TextView
                        android:textSize="@dimen/sp11"
                        android:textStyle="bold"
                        android:textColor="#ff868686"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp7"
                        android:text="@string/please_enter_10_digit_phone_number"
                        android:layout_marginStart="@dimen/dp11" />
                    <com.lihang.ShadowLayout
                        android:layout_gravity="center"
                        android:id="@id/pwdSha"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp6"
                        android:layout_marginTop="@dimen/dp18"
                        android:layout_marginRight="@dimen/dp6"
                        app:hl_cornerRadius="@dimen/dp12"
                        app:hl_layoutBackground="@color/white"
                        app:hl_shadowColor="#54000000"
                        app:hl_shadowHiddenTop="true"
                        app:hl_shadowLimit="@dimen/dp6"
                        app:hl_shadowOffsetY="@dimen/dp3"
                        app:hl_strokeColor="#ff000000">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@id/pwdLin"
                            android:paddingLeft="@dimen/dp5"
                            android:paddingRight="@dimen/dp5"
                            android:visibility="visible"
                            android:layout_width="fill_parent"
                            android:layout_height="@dimen/dp45">
                            <ImageView
                                android:layout_width="@dimen/dp40"
                                android:layout_height="@dimen/dp40"
                                android:src="@mipmap/f_pwd"
                                android:scaleType="fitXY"
                                android:layout_marginEnd="@dimen/dp9" />
                            <RelativeLayout
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content">
                                <EditText
                                    android:textSize="@dimen/sp15"
                                    android:textStyle="bold"
                                    android:textColor="@color/CoMainA"
                                    android:textColorHint="#ff848484"
                                    android:id="@id/pwdEt"
                                    android:background="@null"
                                    android:layout_width="fill_parent"
                                    android:layout_height="@dimen/dp35"
                                    android:hint="@string/password"
                                    android:maxLength="16"
                                    android:layout_toLeftOf="@id/rightLinPwd"
                                    android:inputType="textPassword"
                                    android:layout_marginEnd="@dimen/dp5" />
                                <LinearLayout
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:id="@id/rightLinPwd"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginEnd="@dimen/dp10"
                                    android:layout_alignParentEnd="true">
                                    <ImageView
                                        android:id="@id/clearImg"
                                        android:background="@mipmap/logincleartxt"
                                        android:visibility="gone"
                                        android:layout_width="@dimen/dp24"
                                        android:layout_height="@dimen/dp24"
                                        android:layout_marginEnd="@dimen/dp13" />
                                    <ImageView
                                        android:id="@id/eyeImg"
                                        android:background="@mipmap/eye_b"
                                        android:layout_width="@dimen/dp24"
                                        android:layout_height="@dimen/dp24"
                                        android:layout_marginEnd="@dimen/dp10" />
                                </LinearLayout>
                            </RelativeLayout>
                        </LinearLayout>
                    </com.lihang.ShadowLayout>
                    <TextView
                        android:textSize="@dimen/sp11"
                        android:textStyle="bold"
                        android:textColor="#ff868686"
                        android:id="@id/botPwdTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/please_enter_6_20_characters"
                        android:layout_below="@id/pwdSha"
                        android:layout_marginStart="@dimen/dp11" />
                    <com.lihang.ShadowLayout
                        android:layout_gravity="center"
                        android:id="@id/otpSha"
                        android:visibility="visible"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp6"
                        android:layout_marginTop="@dimen/dp18"
                        android:layout_marginRight="@dimen/dp6"
                        app:hl_cornerRadius="@dimen/dp12"
                        app:hl_layoutBackground="@color/white"
                        app:hl_shadowColor="#54000000"
                        app:hl_shadowHiddenTop="true"
                        app:hl_shadowLimit="@dimen/dp6"
                        app:hl_shadowOffsetY="@dimen/dp3"
                        app:hl_strokeColor="#ff000000">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:id="@id/otpLin"
                            android:layout_width="fill_parent"
                            android:layout_height="@dimen/dp45">
                            <RelativeLayout
                                android:paddingLeft="@dimen/dp5"
                                android:paddingRight="@dimen/dp5"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@id/dunImg"
                                    android:layout_width="@dimen/dp40"
                                    android:layout_height="@dimen/dp40"
                                    android:src="@mipmap/f_otp"
                                    android:layout_centerVertical="true"
                                    android:layout_marginEnd="@dimen/dp9" />
                                <EditText
                                    android:textSize="@dimen/sp15"
                                    android:textStyle="bold"
                                    android:textColor="@color/CoMainA"
                                    android:textColorHint="#ff848484"
                                    android:id="@id/otpEt"
                                    android:background="@null"
                                    android:layout_width="fill_parent"
                                    android:layout_height="@dimen/dp35"
                                    android:hint="@string/enter_otp"
                                    android:maxLength="6"
                                    android:layout_centerVertical="true"
                                    android:inputType="phone"
                                    android:layout_marginEnd="@dimen/dp5"
                                    android:layout_toStartOf="@id/getOtpTxt"
                                    android:layout_toEndOf="@id/dunImg" />
                                <TextView
                                    android:textSize="@dimen/sp13"
                                    android:textStyle="bold"
                                    android:textColor="@color/CoMainA"
                                    android:gravity="center"
                                    android:id="@id/getOtpTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="@dimen/dp35"
                                    android:text="@string/get_otp"
                                    android:layout_centerVertical="true"
                                    android:layout_marginEnd="@dimen/dp16"
                                    android:layout_alignParentEnd="true" />
                            </RelativeLayout>
                        </LinearLayout>
                    </com.lihang.ShadowLayout>
                    <com.lihang.ShadowLayout
                        android:layout_gravity="center"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp6"
                        android:layout_marginTop="@dimen/dp25"
                        android:layout_marginRight="@dimen/dp6"
                        app:hl_cornerRadius="@dimen/dp12"
                        app:hl_layoutBackground="@color/white"
                        app:hl_shadowColor="#54000000"
                        app:hl_shadowHiddenTop="true"
                        app:hl_shadowLimit="@dimen/dp6"
                        app:hl_shadowOffsetY="@dimen/dp3"
                        app:hl_strokeColor="#ff000000">
                        <RelativeLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="@dimen/dp45">
                            <ImageView
                                android:id="@id/codeImg"
                                android:layout_width="@dimen/dp40"
                                android:layout_height="@dimen/dp40"
                                android:src="@mipmap/code_f"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/dp5"
                                android:layout_marginEnd="@dimen/dp6" />
                            <EditText
                                android:textSize="@dimen/sp16"
                                android:textStyle="bold"
                                android:textColor="@color/CoMainA"
                                android:textColorHint="#ffb006ff"
                                android:id="@id/referralEt"
                                android:background="@null"
                                android:layout_width="fill_parent"
                                android:layout_height="@dimen/dp35"
                                android:hint="@string/referral_code"
                                android:maxLength="7"
                                android:layout_centerVertical="true"
                                android:inputType="text"
                                android:layout_marginEnd="@dimen/dp5"
                                android:layout_toEndOf="@id/codeImg" />
                            <TextView
                                android:textSize="@dimen/sp16"
                                android:textStyle="bold"
                                android:textColor="#ff9199a6"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/optional"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="@dimen/dp16"
                                android:layout_alignParentEnd="true" />
                        </RelativeLayout>
                    </com.lihang.ShadowLayout>
                    <com.lihang.ShadowLayout
                        android:layout_gravity="center"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp10"
                        android:layout_marginTop="@dimen/dp40"
                        android:layout_marginRight="@dimen/dp10"
                        app:hl_cornerRadius="@dimen/dp12"
                        app:hl_endColor="@color/MainEnd"
                        app:hl_shadowColor="#54000000"
                        app:hl_shadowHiddenTop="true"
                        app:hl_shadowLimit="@dimen/dp6"
                        app:hl_shadowOffsetY="@dimen/dp3"
                        app:hl_startColor="@color/MainStart"
                        app:hl_strokeColor="@color/CoMainA">
                        <TextView
                            android:textSize="@dimen/sp16"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@id/nextTxt"
                            android:paddingTop="@dimen/dp13"
                            android:paddingBottom="@dimen/dp14"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sign_up" />
                    </com.lihang.ShadowLayout>
                    <LinearLayout
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:paddingLeft="@dimen/dp10"
                        android:paddingRight="@dimen/dp10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5">
                        <TextView
                            android:textSize="@dimen/sp15"
                            android:textStyle="bold"
                            android:textColor="#ff000000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/already_have_an_account" />
                        <TextView
                            android:textSize="@dimen/sp15"
                            android:textStyle="bold"
                            android:textColor="@color/CoMainA"
                            android:id="@id/signInTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sign_in"
                            android:layout_marginStart="@dimen/dp12" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/dp80"
                        android:layout_marginTop="@dimen/dp20"
                        android:layout_marginBottom="@dimen/dp26"
                        android:weightSum="4.0">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="0.0dip"
                            android:layout_height="fill_parent"
                            android:layout_weight="1.0">
                            <ImageView
                                android:layout_width="@dimen/dp43"
                                android:layout_height="@dimen/dp43"
                                android:src="@mipmap/f_copy" />
                            <TextView
                                android:textSize="@dimen/sp11"
                                android:textStyle="bold"
                                android:textColor="#ff010101"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp5"
                                android:text="@string/copy_the_n_unique_link" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="@dimen/dp22"
                            android:layout_height="@dimen/dp6"
                            android:layout_marginTop="@dimen/dp20"
                            android:src="@mipmap/f_gd" />
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="0.0dip"
                            android:layout_height="fill_parent"
                            android:layout_weight="1.0">
                            <ImageView
                                android:layout_width="@dimen/dp43"
                                android:layout_height="@dimen/dp43"
                                android:src="@mipmap/f_link" />
                            <TextView
                                android:textSize="@dimen/sp11"
                                android:textStyle="bold"
                                android:textColor="#ff010101"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp5"
                                android:text="Share with\nyour friends" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="@dimen/dp22"
                            android:layout_height="@dimen/dp6"
                            android:layout_marginTop="@dimen/dp20"
                            android:src="@mipmap/f_gd" />
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="0.0dip"
                            android:layout_height="fill_parent"
                            android:layout_weight="1.0">
                            <ImageView
                                android:layout_width="@dimen/dp43"
                                android:layout_height="@dimen/dp43"
                                android:src="@mipmap/f_success" />
                            <TextView
                                android:textSize="@dimen/sp11"
                                android:textStyle="bold"
                                android:textColor="#ff010101"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp5"
                                android:text="Successfully\nregistered" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="@dimen/dp22"
                            android:layout_height="@dimen/dp6"
                            android:layout_marginTop="@dimen/dp20"
                            android:src="@mipmap/f_gd" />
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="0.0dip"
                            android:layout_height="fill_parent"
                            android:layout_weight="1.0">
                            <ImageView
                                android:layout_width="@dimen/dp43"
                                android:layout_height="@dimen/dp43"
                                android:src="@mipmap/f_reward" />
                            <TextView
                                android:textSize="@dimen/sp11"
                                android:textStyle="bold"
                                android:textColor="#ff010101"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp5"
                                android:text="Get\nRewards" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>