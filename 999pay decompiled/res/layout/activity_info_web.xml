<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/container"
    android:fitsSystemWindows="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/aniRel"
        android:background="@color/CoMainA"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.india.cnm.view.shimmer.ShimmerFrameLayout
            android:id="@id/sfl_layout"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            app:shimmer_duration="1000">
            <TextView
                android:textSize="@dimen/sp35"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@id/loadTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp120"
                android:text="@string/app_name"
                android:alpha="0.95" />
        </com.india.cnm.view.shimmer.ShimmerFrameLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@id/topRel"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/dp49">
        <RelativeLayout
            android:id="@id/backRel"
            android:paddingLeft="@dimen/dp13"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent">
            <ImageView
                android:id="@id/iv_back"
                android:layout_width="@dimen/dp24"
                android:layout_height="@dimen/dp24"
                android:src="@mipmap/back"
                android:layout_centerInParent="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/sp17"
            android:textStyle="bold"
            android:textColor="#ff333333"
            android:id="@id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp11"
            android:layout_marginBottom="@dimen/dp10"
            android:layout_centerInParent="true" />
    </RelativeLayout>
</LinearLayout>