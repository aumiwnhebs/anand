<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/shape_round_gray_5"
        android:paddingLeft="@dimen/dp25"
        android:paddingTop="@dimen/dp10"
        android:paddingRight="@dimen/dp25"
        android:paddingBottom="@dimen/dp15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp16"
            android:textColor="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tip" />
        <TextView
            android:textSize="@dimen/sp14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:text="@string/sorry_your_attempts_have_n_been_exhausted"
            android:lineSpacingExtra="@dimen/dp4" />
    </LinearLayout>
</LinearLayout>