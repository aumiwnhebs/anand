<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/wheel_white"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        layout="@layout/wheel_dialog_title_bar" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/wheel_id_picker_container"
        android:paddingTop="@dimen/wheel_picker_padding_top"
        android:paddingBottom="@dimen/wheel_picker_padding_bottom"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/wheel_picker_padding_left"
        android:paddingEnd="@dimen/wheel_picker_padding_right" />
</LinearLayout>