<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/outSideView"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bgdp14"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/dp47"
        android:layout_marginEnd="@dimen/dp47">
        <TextView
            android:textSize="@dimen/sp16"
            android:textStyle="bold"
            android:textColor="#ff010101"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp14"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp14"
            android:layout_marginBottom="@dimen/dp22"
            android:text="@string/paystr2"
            android:lineSpacingExtra="@dimen/dp7" />
        <TextView
            android:textSize="@dimen/sp17"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/viewOrderTxt"
            android:background="@drawable/bgdp12_main"
            android:layout_width="@dimen/dp156"
            android:layout_height="@dimen/dp52"
            android:layout_marginTop="@dimen/dp10"
            android:layout_marginBottom="@dimen/dp22"
            android:text="@string/view_order" />
    </LinearLayout>
</RelativeLayout>