<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingLeft="@dimen/dp15"
    android:paddingTop="@dimen/dp10"
    android:paddingRight="@dimen/dp15"
    android:paddingBottom="@dimen/dp10"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:selectableItemBackground"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textSize="@dimen/sp12"
        android:textStyle="bold"
        android:textColor="#ff505377"
        android:id="@id/timeTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="13-12-2025" />
    <TextView
        android:textSize="@dimen/sp14"
        android:textStyle="bold"
        android:textColor="#ff010101"
        android:id="@id/titleTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="FreeCharge Wallet Account Linking Guide"
        android:layout_below="@id/timeTxt"
        android:layout_marginEnd="@dimen/dp12"
        android:layout_toStartOf="@id/rightRel"
        android:layout_alignParentStart="true" />
    <RelativeLayout
        android:id="@id/rightRel"
        android:layout_width="@dimen/dp130"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@id/rightImg"
            android:layout_width="@dimen/dp130"
            android:layout_height="@dimen/dp64"
            android:scaleType="fitXY" />
        <TextView
            android:textSize="@dimen/sp14"
            android:textStyle="bold"
            android:textColor="@color/CoMainA"
            android:gravity="center"
            android:id="@id/viewTxt"
            android:background="@drawable/bgdp4strokemain"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp6"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp6"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</RelativeLayout>