<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@color/color_f5f8fe"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.mm.bee.pay.view.bar.TitleBar
        android:id="@id/titleBar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:barText="@string/set_pin_title" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/tvSubmit"
        android:layout_below="@id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:paddingStart="15.0dip"
            android:paddingEnd="15.0dip">
            <TextView
                android:textSize="15.0sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip"
                android:text="@string/set_pin_new" />
            <com.king.view.splitedittext.SplitEditText
                android:textColor="@color/black"
                android:id="@id/etPinNew"
                android:layout_width="fill_parent"
                android:layout_height="45.0dip"
                android:layout_marginTop="8.0dip"
                android:inputType="number"
                app:setBorderColor="@color/color_e8e8e8"
                app:setBorderCornerRadius="12.0dip"
                app:setBorderStyle="box"
                app:setBoxBackgroundColor="@color/white"
                app:setFakeBoldText="true"
                app:setFocusBorderColor="@color/color_365eee"
                app:setInputBorderColor="@color/color_365eee"
                app:setMaxLength="6"
                app:setStrokeWidth="1.0dip"
                app:setTextStyle="cipher_text" />
            <TextView
                android:textSize="15.0sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip"
                android:text="@string/set_pin_new_again" />
            <com.king.view.splitedittext.SplitEditText
                android:textColor="@color/black"
                android:id="@id/etPinNewAgain"
                android:layout_width="fill_parent"
                android:layout_height="45.0dip"
                android:layout_marginTop="8.0dip"
                android:inputType="number"
                app:setBorderColor="@color/color_e8e8e8"
                app:setBorderCornerRadius="12.0dip"
                app:setBorderStyle="box"
                app:setBoxBackgroundColor="@color/white"
                app:setFakeBoldText="true"
                app:setFocusBorderColor="@color/color_365eee"
                app:setInputBorderColor="@color/color_365eee"
                app:setMaxLength="6"
                app:setStrokeWidth="1.0dip"
                app:setTextStyle="cipher_text" />
            <TextView
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip"
                android:text="@string/login_otp" />
            <RelativeLayout
                android:background="@drawable/shape_16dp_line_e8e8e8"
                android:layout_width="fill_parent"
                android:layout_height="52.0dip"
                android:layout_marginTop="8.0dip"
                android:paddingStart="17.0dip"
                android:paddingEnd="0.0dip">
                <EditText
                    android:textSize="15.0sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_b6b6b6"
                    android:id="@id/etOtp"
                    android:background="@null"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:hint="@string/login_otp_enter"
                    android:lines="1"
                    android:maxLength="6"
                    android:inputType="number"
                    android:layout_marginEnd="15.0dip"
                    android:layout_toStartOf="@id/llSendOTP" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/llSendOTP"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_alignParentEnd="true">
                    <View
                        android:background="@color/color_e9e9e9"
                        android:layout_width="1.0dip"
                        android:layout_height="20.0dip" />
                    <TextView
                        android:textSize="14.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_365eee"
                        android:gravity="center"
                        android:id="@id/tvSendOTP"
                        android:layout_width="103.0dip"
                        android:layout_height="fill_parent"
                        android:text="@string/login_otp_send" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="16.0sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@id/tvSubmit"
        android:background="@drawable/shape_16dp_365eee"
        android:layout_width="fill_parent"
        android:layout_height="45.0dip"
        android:layout_marginTop="5.0dip"
        android:layout_marginBottom="20.0dip"
        android:text="@string/set_pin_btn_enable"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="15.0dip"
        android:layout_marginEnd="15.0dip" />
</RelativeLayout>