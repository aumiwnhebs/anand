<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/rlTopUI"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="123.0dip">
        <com.mm.bee.pay.view.RoundedImageView
            android:id="@id/ivImg2"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            app:round_corner_radius="12.0dip" />
        <TextView
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@id/tvTitle2"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip"
            android:text="@string/app_name"
            android:maxLines="2"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="15.0dip"
            android:layout_marginEnd="15.0dip" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@id/rlUI"
        android:layout_width="fill_parent"
        android:layout_height="48.0dip"
        android:layout_marginTop="25.0dip">
        <com.mm.bee.pay.view.RoundedImageView
            android:id="@id/ivImg"
            android:layout_width="48.0dip"
            android:layout_height="fill_parent"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8.0dip"
            app:round_corner_radius="8.0dip" />
        <TextView
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@id/tvTitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_toEndOf="@id/ivImg" />
        <TextView
            android:textSize="12.0sp"
            android:textStyle="bold"
            android:textColor="@color/color_999999"
            android:ellipsize="end"
            android:id="@id/tvDate"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="5.0dip"
            android:layout_toStartOf="@id/ivBack"
            android:layout_toEndOf="@id/ivImg" />
        <ImageView
            android:id="@id/ivBack"
            android:layout_width="20.0dip"
            android:layout_height="20.0dip"
            android:src="@mipmap/ic_my_round_arrow"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</RelativeLayout>