<?xml version="1.0" encoding="utf-8"?>
<com.mm.bee.pay.view.MySwipeRefreshLayout
    android:id="@id/refreshLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ImageView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_my_bg"
            android:scaleType="fitXY" />
        <RelativeLayout
            android:id="@id/rlMyTitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_bar_top">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@id/ivService"
                    android:padding="5.0dip"
                    android:layout_width="35.0dip"
                    android:layout_height="35.0dip"
                    android:src="@mipmap/ic_my_service"
                    android:layout_marginEnd="5.0dip" />
                <ImageView
                    android:id="@id/ivMessage"
                    android:padding="5.0dip"
                    android:layout_width="35.0dip"
                    android:layout_height="35.0dip"
                    android:src="@mipmap/ic_my_message"
                    android:layout_marginEnd="10.0dip" />
            </LinearLayout>
        </RelativeLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_below="@id/rlMyTitle">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:paddingStart="15.0dip"
                android:paddingEnd="15.0dip">
                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="72.0dip"
                    android:layout_marginTop="10.0dip">
                    <ImageView
                        android:id="@id/ivMyHead"
                        android:layout_width="72.0dip"
                        android:layout_height="fill_parent"
                        android:src="@mipmap/ic_my_head" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="15.0dip"
                        android:layout_marginEnd="8.0dip"
                        android:layout_toStartOf="@id/ivChangeNickname"
                        android:layout_toEndOf="@id/ivMyHead">
                        <TextView
                            android:textSize="17.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:ellipsize="end"
                            android:id="@id/tvMyNickName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1" />
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@id/llUserId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10.0dip">
                            <TextView
                                android:textSize="13.0sp"
                                android:textColor="@color/color_666666"
                                android:ellipsize="end"
                                android:id="@id/tvUserId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1" />
                            <ImageView
                                android:layout_width="15.0dip"
                                android:layout_height="15.0dip"
                                android:src="@mipmap/ic_copy"
                                android:layout_marginStart="3.0dip"
                                app:tint="@color/color_666666" />
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView
                        android:id="@id/ivChangeNickname"
                        android:padding="6.0dip"
                        android:layout_width="50.0dip"
                        android:layout_height="50.0dip"
                        android:src="@mipmap/ic_change_nickname"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout
                    android:background="@mipmap/ic_my_data_bg"
                    android:padding="20.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="150.0dip"
                    android:layout_marginTop="20.0dip">
                    <RelativeLayout
                        android:id="@id/rlBalanceTitle"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@id/llMyLimit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true">
                            <ImageView
                                android:layout_width="16.0dip"
                                android:layout_height="16.0dip"
                                android:src="@mipmap/ic_my_rupee" />
                            <TextView
                                android:textSize="14.0sp"
                                android:textStyle="bold"
                                android:textColor="@color/white70"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/my_bee_coin_balance"
                                android:layout_marginStart="4.0dip"
                                android:layout_marginEnd="8.0dip" />
                        </LinearLayout>
                        <TextView
                            android:textSize="12.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_bCoin"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <TextView
                        android:textSize="20.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_fdf02a"
                        android:id="@id/tvLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6.0dip"
                        android:text="@string/zero"
                        android:layout_below="@id/rlBalanceTitle" />
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0">
                            <TextView
                                android:textSize="12.0sp"
                                android:textStyle="bold"
                                android:textColor="@color/white60"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/my_bee_coin" />
                            <TextView
                                android:textSize="16.0sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:id="@id/tvTotalEarnings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8.0dip"
                                android:text="@string/default_amount" />
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0">
                            <TextView
                                android:textSize="12.0sp"
                                android:textStyle="bold"
                                android:textColor="@color/white60"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/my_today_earnings" />
                            <TextView
                                android:textSize="16.0sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:id="@id/tvTodayEarnings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8.0dip"
                                android:text="@string/default_amount" />
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/shape_16dp_ffffff"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:paddingStart="15.0dip"
                    android:paddingEnd="15.0dip">
                    <RelativeLayout
                        android:layout_width="fill_parent"
                        android:layout_height="35.0dip"
                        android:layout_marginTop="14.0dip"
                        android:layout_marginBottom="8.0dip">
                        <TextView
                            android:textSize="18.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_date"
                            android:layout_centerVertical="true" />
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@id/llDate"
                            android:background="@drawable/shape_18dp_e7ecfd"
                            android:layout_width="100.0dip"
                            android:layout_height="fill_parent"
                            android:layout_alignParentEnd="true">
                            <TextView
                                android:textSize="13.0sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_365eee"
                                android:id="@id/tvDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                            <ImageView
                                android:layout_width="12.0dip"
                                android:layout_height="12.0dip"
                                android:src="@mipmap/ic_my_down"
                                android:layout_marginStart="4.0dip" />
                        </LinearLayout>
                    </RelativeLayout>
                    <View
                        android:background="@color/black6"
                        android:layout_width="fill_parent"
                        android:layout_height="1.0dip" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@id/dateRecyclerView"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10.0dip" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/shape_16dp_ffffff"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:paddingStart="15.0dip"
                    android:paddingEnd="15.0dip">
                    <TextView
                        android:textSize="18.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18.0dip"
                        android:layout_marginBottom="12.0dip"
                        android:text="@string/my_history" />
                    <View
                        android:background="@color/black6"
                        android:layout_width="fill_parent"
                        android:layout_height="1.0dip" />
                    <RelativeLayout
                        android:id="@id/rlBuyHistory"
                        android:layout_width="fill_parent"
                        android:layout_height="45.0dip"
                        android:layout_marginTop="5.0dip">
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_buy_history"
                            android:layout_centerVertical="true" />
                        <ImageView
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:src="@mipmap/ic_my_right_arrow"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@id/rlUsdtHistory"
                        android:layout_width="fill_parent"
                        android:layout_height="45.0dip"
                        android:layout_marginBottom="5.0dip">
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_usdt_history"
                            android:layout_centerVertical="true" />
                        <ImageView
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:src="@mipmap/ic_my_right_arrow"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@id/rlSellHistory"
                        android:layout_width="fill_parent"
                        android:layout_height="45.0dip"
                        android:layout_marginBottom="5.0dip">
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_sell_history"
                            android:layout_centerVertical="true" />
                        <ImageView
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:src="@mipmap/ic_my_right_arrow"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@id/rlQuotaHistory"
                        android:layout_width="fill_parent"
                        android:layout_height="45.0dip">
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_quota_history"
                            android:layout_centerVertical="true" />
                        <ImageView
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:src="@mipmap/ic_my_right_arrow"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/shape_16dp_ffffff"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:paddingStart="15.0dip"
                    android:paddingEnd="15.0dip">
                    <TextView
                        android:textSize="18.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18.0dip"
                        android:layout_marginBottom="12.0dip"
                        android:text="@string/my_settings" />
                    <View
                        android:background="@color/black6"
                        android:layout_width="fill_parent"
                        android:layout_height="1.0dip" />
                    <RelativeLayout
                        android:id="@id/rlPassword"
                        android:layout_width="fill_parent"
                        android:layout_height="45.0dip"
                        android:layout_marginTop="5.0dip">
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_password"
                            android:layout_centerVertical="true" />
                        <ImageView
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:src="@mipmap/ic_my_right_arrow"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@id/rlPin"
                        android:layout_width="fill_parent"
                        android:layout_height="45.0dip">
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pin"
                            android:layout_centerVertical="true" />
                        <ImageView
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:src="@mipmap/ic_my_right_arrow"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@id/rlTgRobot"
                        android:layout_width="fill_parent"
                        android:layout_height="45.0dip">
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_tg_robot"
                            android:layout_centerVertical="true" />
                        <ImageView
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:src="@mipmap/ic_my_right_arrow"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@id/rlVersion"
                        android:layout_width="fill_parent"
                        android:layout_height="45.0dip"
                        android:layout_marginBottom="5.0dip">
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_version"
                            android:layout_centerVertical="true" />
                        <ImageView
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:src="@mipmap/ic_my_right_arrow"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                </LinearLayout>
                <TextView
                    android:textSize="16.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_ea3047"
                    android:gravity="center"
                    android:id="@id/tvLogOut"
                    android:background="@drawable/shape_12dp_ffe5e9"
                    android:layout_width="fill_parent"
                    android:layout_height="50.0dip"
                    android:layout_marginTop="12.0dip"
                    android:layout_marginBottom="25.0dip"
                    android:text="@string/my_log_out_btn" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>
</com.mm.bee.pay.view.MySwipeRefreshLayout>