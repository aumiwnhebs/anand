<?xml version="1.0" encoding="utf-8"?>
<com.kongzue.dialogx.util.views.DialogXBaseRelativeLayout
    android:orientation="vertical"
    android:id="@id/box_root"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    app:baseFocusable="false"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.kongzue.dialogx.util.views.MaxLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/box_body"
        android:background="@drawable/rect_dialogx_material_popnotification_bkg_night"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15.0dip"
        android:layout_marginRight="15.0dip"
        android:elevation="5.0dip">
        <ImageView
            android:id="@id/img_dialogx_pop_icon"
            android:visibility="gone"
            android:layout_width="45.0dip"
            android:layout_height="45.0dip"
            android:layout_marginLeft="15.0dip"
            android:layout_marginTop="12.0dip"
            android:layout_marginRight="-10.0dip"
            android:layout_marginBottom="12.0dip" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="15.0dip"
            android:paddingBottom="15.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0dip"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center|left"
                android:id="@id/txt_dialogx_pop_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20.0dip"
                android:layout_marginRight="15.0dip"
                android:text="Notification!" />
            <TextView
                android:textSize="14.0dip"
                android:textColor="@color/white70"
                android:gravity="center|left"
                android:id="@id/txt_dialogx_pop_message"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20.0dip"
                android:layout_marginTop="2.0dip"
                android:layout_marginRight="15.0dip"
                android:layout_marginBottom="2.0dip"
                android:text="Notification!" />
            <RelativeLayout
                android:id="@id/box_custom"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:textSize="14.0dip"
                android:textColor="@color/dialogxPopButtonBlueDark"
                android:gravity="center|left"
                android:id="@id/txt_dialogx_button"
                android:background="@drawable/button_dialogx_material_night"
                android:paddingLeft="10.0dip"
                android:paddingTop="5.0dip"
                android:paddingRight="10.0dip"
                android:paddingBottom="5.0dip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginLeft="10.0dip"
                android:layout_marginRight="5.0dip"
                android:text="Dismiss"
                android:singleLine="true" />
        </LinearLayout>
    </com.kongzue.dialogx.util.views.MaxLinearLayout>
</com.kongzue.dialogx.util.views.DialogXBaseRelativeLayout>