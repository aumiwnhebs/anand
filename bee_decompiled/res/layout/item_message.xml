<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/shape_12dp_ffffff"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:paddingStart="15.0dip"
        android:paddingEnd="15.0dip">
        <ImageView
            android:layout_width="20.0dip"
            android:layout_height="20.0dip"
            android:src="@mipmap/ic_message"
            android:layout_centerVertical="true" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="@color/color_888888"
            android:id="@id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <View
        android:background="@color/black5"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:layout_marginStart="15.0dip">
        <View
            android:id="@id/dot"
            android:background="@drawable/shape_dot_fe4848"
            android:visibility="gone"
            android:layout_width="6.0dip"
            android:layout_height="6.0dip" />
        <TextView
            android:textSize="16.0sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:layout_marginStart="4.0dip" />
    </LinearLayout>
    <TextView
        android:textSize="12.0sp"
        android:textStyle="bold"
        android:textColor="@color/color_666666"
        android:ellipsize="end"
        android:id="@id/tvContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.0dip"
        android:maxLines="3"
        android:layout_marginStart="15.0dip"
        android:layout_marginEnd="15.0dip" />
    <View
        android:background="@color/black5"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip"
        android:layout_marginTop="10.0dip" />
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:paddingStart="15.0dip"
        android:paddingEnd="15.0dip">
        <TextView
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="@color/color_365eee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_message_view"
            android:layout_centerVertical="true" />
        <ImageView
            android:layout_width="15.0dip"
            android:layout_height="15.0dip"
            android:src="@mipmap/ic_black_arrow"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</LinearLayout>