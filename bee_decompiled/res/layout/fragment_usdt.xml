<?xml version="1.0" encoding="utf-8"?>
<com.mm.bee.pay.view.MySwipeRefreshLayout
    android:id="@id/refreshLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/llRoot"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="5.0dip">
        <androidx.core.widget.NestedScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:background="@drawable/shape_12dp_ffffff"
                    android:paddingTop="15.0dip"
                    android:paddingBottom="15.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:paddingStart="10.0dip"
                    android:paddingEnd="10.0dip"
                    android:layout_marginStart="15.0dip"
                    android:layout_marginEnd="15.0dip">
                    <RelativeLayout
                        android:id="@id/rlPayingOrder"
                        android:background="@drawable/shape_20dp_fff7ec_line_ffccb3"
                        android:padding="10.0dip"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12.0dip">
                        <ImageView
                            android:id="@id/ivPayingImg"
                            android:layout_width="31.0dip"
                            android:layout_height="31.0dip"
                            android:src="@mipmap/ic_hourglass"
                            android:layout_centerVertical="true" />
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="5.0dip"
                            android:layout_marginEnd="5.0dip"
                            android:layout_toStartOf="@id/tvPayingContinue"
                            android:layout_toEndOf="@id/ivPayingImg">
                            <TextView
                                android:textSize="10.0sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_666666"
                                android:id="@id/tvPayingOrderNumber"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/usdt_paying_order_number" />
                            <TextView
                                android:textSize="11.0sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_ea7434"
                                android:ellipsize="end"
                                android:id="@id/tvPayingOrderTips"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/usdt_paying_order_tips"
                                android:maxLines="2" />
                        </LinearLayout>
                        <TextView
                            android:textSize="12.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@id/tvPayingContinue"
                            android:background="@drawable/shape_50dp_365eee"
                            android:layout_width="70.0dip"
                            android:layout_height="26.0dip"
                            android:text="@string/usdt_paying_continue"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:background="@drawable/shape_dot_5778f1"
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:text="1" />
                        <TextView
                            android:textSize="14.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/usdt_recharge_step1"
                            android:layout_marginStart="10.0dip" />
                    </LinearLayout>
                    <View
                        android:background="@color/color_cccccc"
                        android:layout_width="2.0dip"
                        android:layout_height="20.0dip"
                        android:layout_marginTop="3.0dip"
                        android:layout_marginBottom="3.0dip"
                        android:layout_marginStart="10.0dip" />
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:background="@drawable/shape_dot_fc9f13"
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:text="2" />
                        <TextView
                            android:textSize="14.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/usdt_recharge_step2"
                            android:layout_marginStart="10.0dip" />
                    </LinearLayout>
                    <View
                        android:background="@color/color_cccccc"
                        android:layout_width="2.0dip"
                        android:layout_height="20.0dip"
                        android:layout_marginTop="3.0dip"
                        android:layout_marginBottom="3.0dip"
                        android:layout_marginStart="10.0dip" />
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:background="@drawable/shape_dot_3ed7aa"
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:text="3" />
                        <TextView
                            android:textSize="14.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/usdt_recharge_step3"
                            android:layout_marginStart="10.0dip" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:background="@drawable/shape_12dp_ffffff"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dip"
                    android:paddingStart="15.0dip"
                    android:paddingEnd="15.0dip"
                    android:layout_marginStart="15.0dip"
                    android:layout_marginEnd="15.0dip">
                    <TextView
                        android:textSize="18.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16.0dip"
                        android:text="@string/usdt_transfer" />
                    <RelativeLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15.0dip">
                        <TextView
                            android:textSize="14.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_999999"
                            android:id="@id/tvCalculatorTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/usdt_calculator" />
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:ellipsize="start"
                            android:gravity="end|center"
                            android:id="@id/tvCalculator"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/zero"
                            android:lines="1"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="20.0dip"
                            android:layout_toEndOf="@id/tvCalculatorTitle"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <EditText
                        android:textSize="20.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textColorHint="@color/color_999999"
                        android:gravity="center_vertical"
                        android:id="@id/etAmount"
                        android:background="@drawable/shape_12dp_line_e8e8e8"
                        android:layout_width="fill_parent"
                        android:layout_height="48.0dip"
                        android:layout_marginTop="6.0dip"
                        android:text="1"
                        android:hint="@string/usdt_zero"
                        android:maxLength="15"
                        android:digits="0123456789."
                        android:inputType="numberDecimal"
                        android:paddingStart="15.0dip"
                        android:paddingEnd="15.0dip" />
                    <RelativeLayout
                        android:id="@id/rlBonus"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15.0dip">
                        <TextView
                            android:textSize="14.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_999999"
                            android:id="@id/tvEstimatedTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/usdt_estimated_bonus" />
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:ellipsize="start"
                            android:gravity="end|center"
                            android:id="@id/tvBonus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero"
                            android:lines="1"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="20.0dip"
                            android:layout_toEndOf="@id/tvEstimatedTitle"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15.0dip"
                        android:layout_marginBottom="20.0dip">
                        <TextView
                            android:textSize="14.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@id/tvWillTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/usdt_will_you" />
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:ellipsize="start"
                            android:gravity="end|center"
                            android:id="@id/tvTotalIncome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero"
                            android:lines="1"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="20.0dip"
                            android:layout_toEndOf="@id/tvWillTitle"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <TextView
                        android:textSize="16.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@id/tvNext"
                        android:background="@drawable/shape_16dp_365eee"
                        android:layout_width="fill_parent"
                        android:layout_height="45.0dip"
                        android:layout_marginBottom="20.0dip"
                        android:text="@string/usdt_confirm"
                        android:layout_marginStart="15.0dip"
                        android:layout_marginEnd="15.0dip" />
                </LinearLayout>
                <View
                    android:layout_width="fill_parent"
                    android:layout_height="50.0dip" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</com.mm.bee.pay.view.MySwipeRefreshLayout>