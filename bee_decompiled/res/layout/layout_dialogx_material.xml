<?xml version="1.0" encoding="utf-8"?>
<com.kongzue.dialogx.util.views.DialogXBaseRelativeLayout
    android:orientation="vertical"
    android:id="@id/box_root"
    android:background="@color/black20"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.kongzue.dialogx.util.views.MaxRelativeLayout
            android:id="@id/bkg"
            android:background="@drawable/rect_dialogx_material_bkg_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="35.0dip"
            android:layout_marginEnd="35.0dip"
            android:elevation="27.0dip">
            <LinearLayout
                android:orientation="vertical"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="21.0dip"
                    android:textColor="@color/black"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_horizontal"
                    android:id="@id/txt_dialog_title"
                    android:paddingTop="15.0dip"
                    android:paddingBottom="15.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="Title"
                    android:paddingStart="20.0dip"
                    android:paddingEnd="20.0dip" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <com.kongzue.dialogx.util.views.DialogScrollView
                        android:id="@id/scrollView"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="16.0dip"
                                android:textColor="@color/black70"
                                android:layout_gravity="center_horizontal"
                                android:id="@id/txt_dialog_tip"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:text="This is content text."
                                android:layout_marginStart="20.0dip"
                                android:layout_marginEnd="20.0dip" />
                            <RelativeLayout
                                android:id="@id/box_custom"
                                android:visibility="gone"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content" />
                            <EditText
                                android:theme="@style/DialogXCompatThemeLight"
                                android:textSize="18.0dip"
                                android:textColor="@color/black90"
                                android:layout_gravity="center_horizontal"
                                android:id="@id/txt_input"
                                android:paddingTop="10.0dip"
                                android:paddingBottom="10.0dip"
                                android:scrollbars="vertical"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10.0dip"
                                android:text=""
                                android:maxLines="1"
                                android:inputType="text"
                                android:layout_marginStart="20.0dip"
                                android:layout_marginEnd="20.0dip" />
                        </LinearLayout>
                    </com.kongzue.dialogx.util.views.DialogScrollView>
                    <FrameLayout
                        android:id="@id/box_list"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="end|center"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@id/box_button"
                    android:paddingTop="10.0dip"
                    android:paddingBottom="10.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dip"
                    android:paddingStart="10.0dip"
                    android:paddingEnd="10.0dip">
                    <TextView
                        android:textSize="15.0dip"
                        android:textColor="@color/colorAccent"
                        android:gravity="center"
                        android:id="@id/btn_selectOther"
                        android:background="@drawable/button_dialogx_material_light"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="36.0dip"
                        android:text="Other"
                        android:paddingStart="15.0dip"
                        android:paddingEnd="15.0dip" />
                    <Space
                        android:id="@id/space_other_button"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                    <TextView
                        android:textSize="15.0dip"
                        android:textColor="@color/colorAccent"
                        android:gravity="center"
                        android:id="@id/btn_selectNegative"
                        android:background="@drawable/button_dialogx_material_light"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="36.0dip"
                        android:text="Cancel"
                        android:paddingStart="15.0dip"
                        android:paddingEnd="15.0dip" />
                    <TextView
                        android:textSize="15.0dip"
                        android:textColor="@color/colorAccent"
                        android:gravity="center"
                        android:id="@id/btn_selectPositive"
                        android:background="@drawable/button_dialogx_material_light"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="36.0dip"
                        android:text="OK"
                        android:paddingStart="15.0dip"
                        android:paddingEnd="15.0dip" />
                </LinearLayout>
            </LinearLayout>
        </com.kongzue.dialogx.util.views.MaxRelativeLayout>
    </RelativeLayout>
</com.kongzue.dialogx.util.views.DialogXBaseRelativeLayout>