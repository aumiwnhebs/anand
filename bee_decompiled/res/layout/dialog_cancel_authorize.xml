<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@mipmap/ic_dialog_bg"
        android:padding="15.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24.0dip"
        android:layout_marginEnd="24.0dip">
        <TextView
            android:textSize="20.0sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:text="@string/upi_details_account" />
        <TextView
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="@color/color_999999"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15.0dip"
            android:text="@string/upi_details_no_tips" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/llBottomBtn"
            android:layout_width="fill_parent"
            android:layout_height="45.0dip"
            android:layout_marginTop="25.0dip">
            <TextView
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="@color/color_666666"
                android:gravity="center"
                android:id="@id/tvCancel"
                android:background="@drawable/shape_16dp_line_d6d6d6"
                android:layout_width="0.0dip"
                android:layout_height="45.0dip"
                android:text="@string/cancel"
                android:layout_weight="1.0"
                android:layout_marginEnd="11.0dip" />
            <TextView
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/tvYes"
                android:background="@drawable/shape_16dp_365eee"
                android:layout_width="0.0dip"
                android:layout_height="45.0dip"
                android:text="@string/upi_details_no_unlink"
                android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>