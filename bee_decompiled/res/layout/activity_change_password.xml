<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/color_f5f8fe"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.mm.bee.pay.view.bar.TitleBar
        android:id="@id/titleBar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:barText="@string/my_password_change" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginStart="20.0dip"
            android:layout_marginEnd="20.0dip">
            <TextView
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28.0dip"
                android:text="@string/my_password_new" />
            <RelativeLayout
                android:background="@drawable/shape_16dp_line_e8e8e8"
                android:layout_width="fill_parent"
                android:layout_height="52.0dip"
                android:layout_marginTop="8.0dip">
                <EditText
                    android:textSize="14.0sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_b3b4b7"
                    android:id="@id/etNewPassword"
                    android:background="@null"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:hint="@string/my_password_new_enter"
                    android:maxLines="1"
                    android:inputType="textPassword"
                    android:layout_marginStart="16.0dip"
                    android:layout_marginEnd="16.0dip"
                    android:layout_toStartOf="@id/ivNewPasswordSee" />
                <ImageView
                    android:id="@id/ivNewPasswordSee"
                    android:padding="13.0dip"
                    android:layout_width="52.0dip"
                    android:layout_height="fill_parent"
                    android:src="@mipmap/ic_login_eye_off"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <TextView
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip"
                android:text="@string/my_password_new_confirm" />
            <RelativeLayout
                android:background="@drawable/shape_16dp_line_e8e8e8"
                android:layout_width="fill_parent"
                android:layout_height="52.0dip"
                android:layout_marginTop="8.0dip">
                <EditText
                    android:textSize="14.0sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_b3b4b7"
                    android:id="@id/etAgainNewPassword"
                    android:background="@null"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:hint="@string/login_password_again_password"
                    android:maxLines="1"
                    android:inputType="textPassword"
                    android:layout_marginStart="16.0dip"
                    android:layout_marginEnd="16.0dip"
                    android:layout_toStartOf="@id/ivAgainNewPasswordSee" />
                <ImageView
                    android:id="@id/ivAgainNewPasswordSee"
                    android:padding="13.0dip"
                    android:layout_width="52.0dip"
                    android:layout_height="fill_parent"
                    android:src="@mipmap/ic_login_eye_off"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <TextView
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip"
                android:text="@string/login_otp" />
            <RelativeLayout
                android:background="@drawable/shape_16dp_line_e8e8e8"
                android:layout_width="fill_parent"
                android:layout_height="52.0dip"
                android:layout_marginTop="8.0dip"
                android:paddingStart="17.0dip"
                android:paddingEnd="0.0dip">
                <EditText
                    android:textSize="15.0sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_b6b6b6"
                    android:id="@id/etOtp"
                    android:background="@null"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:hint="@string/login_otp_enter"
                    android:lines="1"
                    android:maxLength="6"
                    android:inputType="number"
                    android:layout_marginEnd="15.0dip"
                    android:layout_toStartOf="@id/llSendOTP" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/llSendOTP"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_alignParentEnd="true">
                    <View
                        android:background="@color/color_e9e9e9"
                        android:layout_width="1.0dip"
                        android:layout_height="20.0dip" />
                    <TextView
                        android:textSize="14.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_365eee"
                        android:gravity="center"
                        android:id="@id/tvSendOTP"
                        android:layout_width="103.0dip"
                        android:layout_height="fill_parent"
                        android:text="@string/login_otp_send" />
                </LinearLayout>
            </RelativeLayout>
            <TextView
                android:textSize="15.0sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/tvSave"
                android:background="@drawable/shape_25dp_365eee"
                android:layout_width="fill_parent"
                android:layout_height="45.0dip"
                android:layout_marginTop="40.0dip"
                android:text="@string/save" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>