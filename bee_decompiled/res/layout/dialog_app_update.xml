<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_12dp_ffffff"
        android:padding="24.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20.0dip"
        android:layout_marginEnd="20.0dip">
        <TextView
            android:textSize="18.0sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16.0dip"
            android:text="@string/update_title" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ff666666"
            android:id="@id/tv_content"
            android:scrollbars="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20.0dip"
            android:lineSpacingMultiplier="1.2" />
        <ProgressBar
            android:id="@id/progress_bar"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="8.0dip"
            android:layout_marginBottom="8.0dip"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/color_365eee"
            style="?android:progressBarStyleHorizontal" />
        <TextView
            android:textSize="16.0sp"
            android:textStyle="bold"
            android:textColor="@color/color_365eee"
            android:gravity="center"
            android:id="@id/tv_progress"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16.0dip"
            android:text="0%" />
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@id/ll_buttons"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13.0sp"
                android:textStyle="bold"
                android:textColor="#ff666666"
                android:gravity="center"
                android:id="@id/btn_exit"
                android:background="@drawable/shape_8dp_line_cccccc"
                android:layout_width="0.0dip"
                android:layout_height="40.0dip"
                android:text="@string/update_exit"
                android:layout_weight="1.0" />
            <TextView
                android:textSize="13.0sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/btn_update"
                android:background="@drawable/shape_8dp_365eee"
                android:layout_width="0.0dip"
                android:layout_height="40.0dip"
                android:text="@string/update_now"
                android:layout_weight="1.0"
                android:layout_marginStart="15.0dip" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>