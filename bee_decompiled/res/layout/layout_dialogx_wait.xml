<?xml version="1.0" encoding="utf-8"?>
<com.kongzue.dialogx.util.views.DialogXBaseRelativeLayout
    android:orientation="vertical"
    android:id="@id/box_root"
    android:background="@color/black40"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.kongzue.dialogx.util.views.MaxRelativeLayout
        android:id="@id/bkg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="125.0dip"
        android:minHeight="125.0dip"
        android:layout_centerInParent="true">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="1.5dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <RelativeLayout
                android:id="@id/box_progress"
                android:layout_width="65.0dip"
                android:layout_height="65.0dip" />
            <RelativeLayout
                android:id="@id/box_customView"
                android:visibility="gone"
                android:layout_width="65.0dip"
                android:layout_height="65.0dip" />
            <TextView
                android:textSize="14.0dip"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/txt_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15.0dip"
                android:layout_marginTop="10.0dip"
                android:layout_marginRight="15.0dip"
                android:text="Please Wait"
                android:maxLines="3" />
        </LinearLayout>
    </com.kongzue.dialogx.util.views.MaxRelativeLayout>
</com.kongzue.dialogx.util.views.DialogXBaseRelativeLayout>