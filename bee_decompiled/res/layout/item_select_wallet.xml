<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/rlWalletBg"
    android:background="@drawable/shape_16dp_ffffff"
    android:padding="12.0dip"
    android:layout_width="fill_parent"
    android:layout_height="84.0dip"
    android:layout_marginTop="10.0dip"
    android:layout_marginStart="15.0dip"
    android:layout_marginEnd="15.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/ivLogo"
        android:layout_width="60.0dip"
        android:layout_height="fill_parent"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_marginEnd="12.0dip" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/ivLogo">
        <ImageView
            android:id="@id/ivStatus"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:src="@mipmap/ic_select_wallet_active" />
        <TextView
            android:textSize="12.0sp"
            android:textStyle="bold"
            android:textColor="@color/color_999999"
            android:gravity="center"
            android:id="@id/tvStatus"
            android:background="@drawable/shape_12dp_line_d6d6d6"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="22.0dip"
            android:text="@string/buy_select_wallet_status_expired"
            android:paddingStart="8.0dip"
            android:paddingEnd="8.0dip"
            android:layout_marginStart="4.0dip" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="@color/color_666666"
            android:ellipsize="end"
            android:id="@id/tvStatusExpiredTips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buy_select_wallet_status_expired_describe"
            android:maxLines="1"
            android:layout_marginStart="4.0dip" />
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/ivLogo">
        <TextView
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@id/tvPhoneAndTips"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:layout_marginEnd="5.0dip"
            android:layout_toStartOf="@id/tvWalletName" />
        <TextView
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@id/tvWalletName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</RelativeLayout>