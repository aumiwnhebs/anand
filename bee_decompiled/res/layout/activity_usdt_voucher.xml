<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@color/color_f5f8fe"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.mm.bee.pay.view.bar.TitleBar
        android:id="@id/titleBar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:barText="@string/usdt_submit" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/tvSubmit"
        android:layout_below="@id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginStart="15.0dip"
            android:layout_marginEnd="15.0dip">
            <RelativeLayout
                android:background="@drawable/shape_12dp_ffffff"
                android:padding="15.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="25.0dip"
                    android:layout_centerVertical="true">
                    <TextView
                        android:textSize="13.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@id/tvHour"
                        android:background="@drawable/shape_5dp_gradient_ffce46_ff9e00"
                        android:layout_width="25.0dip"
                        android:layout_height="fill_parent"
                        android:text="@string/double_zero" />
                    <TextView
                        android:textSize="15.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_faa311"
                        android:gravity="center"
                        android:id="@id/tvCountdownColon1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/colon"
                        android:layout_marginStart="5.0dip"
                        android:layout_marginEnd="5.0dip" />
                    <TextView
                        android:textSize="13.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@id/tvMinute"
                        android:background="@drawable/shape_5dp_gradient_ffce46_ff9e00"
                        android:layout_width="25.0dip"
                        android:layout_height="fill_parent"
                        android:text="@string/double_zero" />
                    <TextView
                        android:textSize="15.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_faa311"
                        android:gravity="center"
                        android:id="@id/tvCountdownColon2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/colon"
                        android:layout_marginStart="5.0dip"
                        android:layout_marginEnd="5.0dip" />
                    <TextView
                        android:textSize="13.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@id/tvSecond"
                        android:background="@drawable/shape_5dp_gradient_ffce46_ff9e00"
                        android:layout_width="25.0dip"
                        android:layout_height="fill_parent"
                        android:text="@string/double_zero" />
                </LinearLayout>
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@id/tvCancel"
                    android:background="@drawable/shape_10dp_cccccc"
                    android:layout_width="wrap_content"
                    android:layout_height="30.0dip"
                    android:text="@string/usdt_cancel_recharge"
                    android:layout_centerVertical="true"
                    android:paddingStart="10.0dip"
                    android:paddingEnd="10.0dip"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@drawable/shape_12dp_ffffff"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:paddingStart="15.0dip"
                android:paddingEnd="15.0dip">
                <TextView
                    android:textSize="18.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13.0dip"
                    android:text="@string/usdt_trc_20" />
                <ImageView
                    android:id="@id/ivQRCode"
                    android:layout_width="164.0dip"
                    android:layout_height="164.0dip"
                    android:layout_marginTop="12.0dip"
                    android:scaleType="fitXY" />
                <TextView
                    android:textSize="14.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_999999"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20.0dip"
                    android:text="@string/usdt_address_title" />
                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_666666"
                        android:gravity="center_vertical"
                        android:id="@id/tvAddress"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/ivCopy" />
                    <ImageView
                        android:id="@id/ivCopy"
                        android:paddingTop="8.0dip"
                        android:paddingBottom="8.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/ic_copy"
                        android:layout_centerVertical="true"
                        android:paddingStart="10.0dip"
                        android:paddingEnd="0.0dip"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/shape_12dp_f3f5f8"
                    android:paddingTop="11.0dip"
                    android:paddingBottom="11.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7.0dip"
                    android:layout_marginBottom="20.0dip">
                    <ImageView
                        android:layout_width="16.0dip"
                        android:layout_height="16.0dip"
                        android:src="@mipmap/ic_usdt_tips" />
                    <TextView
                        android:textSize="14.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/usdt_only_network"
                        android:layout_marginStart="8.0dip" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:background="@drawable/shape_12dp_ffffff"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:paddingStart="15.0dip"
                android:paddingEnd="15.0dip">
                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18.0dip">
                    <TextView
                        android:textSize="16.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/usdt_recharge_amount"
                        android:layout_centerVertical="true" />
                    <TextView
                        android:textSize="20.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_365eee"
                        android:id="@id/tvUsdtAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zero"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="90.0dip"
                    android:layout_marginTop="15.0dip">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:background="@drawable/shape_16dp_fff9e2"
                        android:layout_width="0.0dip"
                        android:layout_height="fill_parent"
                        android:layout_weight="1.0">
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:ellipsize="end"
                            android:id="@id/tvInrAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20.0dip"
                            android:text="@string/default_amount"
                            android:maxLines="1" />
                        <TextView
                            android:textSize="12.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_999999"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="fill_parent"
                            android:text="@string/usdt_recharge_amount_inr" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:background="@drawable/shape_16dp_defff1"
                        android:layout_width="0.0dip"
                        android:layout_height="fill_parent"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip"
                        android:layout_marginEnd="10.0dip">
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:ellipsize="end"
                            android:id="@id/tvBonus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20.0dip"
                            android:text="@string/default_amount"
                            android:maxLines="1" />
                        <TextView
                            android:textSize="12.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_999999"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="fill_parent"
                            android:text="@string/usdt_amount_bonus" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:background="@drawable/shape_16dp_e0f9ff"
                        android:layout_width="0.0dip"
                        android:layout_height="fill_parent"
                        android:layout_weight="1.0">
                        <TextView
                            android:textSize="15.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:ellipsize="end"
                            android:id="@id/tvTotalIncome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20.0dip"
                            android:text="@string/default_amount"
                            android:maxLines="1" />
                        <TextView
                            android:textSize="12.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_999999"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="fill_parent"
                            android:text="@string/usdt_you_receive" />
                    </LinearLayout>
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20.0dip">
                    <TextView
                        android:textSize="16.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/usdt_txid_title"
                        android:layout_centerVertical="true" />
                    <TextView
                        android:textSize="14.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@id/tvPasteTxid"
                        android:background="@drawable/shape_16dp_365eee"
                        android:paddingTop="5.0dip"
                        android:paddingBottom="5.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/paste"
                        android:layout_centerVertical="true"
                        android:paddingStart="15.0dip"
                        android:paddingEnd="15.0dip"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <EditText
                    android:textSize="13.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_999999"
                    android:gravity="center_vertical"
                    android:id="@id/etTxid"
                    android:background="@drawable/shape_12dp_line_e8e8e8"
                    android:paddingTop="10.0dip"
                    android:paddingBottom="10.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="70.0dip"
                    android:layout_marginTop="12.0dip"
                    android:hint="@string/usdt_txid_enter"
                    android:maxLines="5"
                    android:inputType="textMultiLine"
                    android:paddingStart="15.0dip"
                    android:paddingEnd="15.0dip" />
                <TextView
                    android:textSize="16.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.0dip"
                    android:text="@string/usdt_proof_title" />
                <RelativeLayout
                    android:layout_width="111.0dip"
                    android:layout_height="111.0dip"
                    android:layout_marginTop="12.0dip"
                    android:layout_marginBottom="20.0dip">
                    <RelativeLayout
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
                        <ImageView
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:src="@mipmap/ic_add_img"
                            android:layout_centerInParent="true" />
                        <com.mm.bee.pay.view.RoundedImageView
                            android:id="@id/ivAddImg"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:scaleType="centerCrop"
                            app:round_corner_radius="16.0dip" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@id/rlDelete"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true">
                        <ImageView
                            android:layout_width="20.0dip"
                            android:layout_height="20.0dip"
                            android:layout_marginTop="6.0dip"
                            android:src="@mipmap/ic_add_img_delete"
                            android:layout_centerInParent="true"
                            android:layout_marginEnd="6.0dip" />
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="16.0sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@id/tvSubmit"
        android:background="@drawable/shape_16dp_365eee"
        android:layout_width="fill_parent"
        android:layout_height="45.0dip"
        android:layout_marginTop="5.0dip"
        android:layout_marginBottom="25.0dip"
        android:text="@string/submit"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="15.0dip"
        android:layout_marginEnd="15.0dip" />
</RelativeLayout>