<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_20dp_ffffff"
        android:paddingTop="18.0dip"
        android:paddingBottom="25.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15.0dip"
        android:paddingEnd="15.0dip"
        android:layout_marginStart="20.0dip"
        android:layout_marginEnd="20.0dip">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18.0sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/captcha_verify_title"
                android:layout_centerHorizontal="true" />
            <ImageView
                android:id="@id/ivClose"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="2.0dip"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="@string/close"
                android:layout_alignParentEnd="true"
                app:tint="@color/color_666666" />
        </RelativeLayout>
        <TextView
            android:textSize="13.0sp"
            android:textColor="@color/color_666666"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:text="@string/captcha_verify_subtitle" />
        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="85.0dip"
            android:layout_marginTop="24.0dip">
            <WebView
                android:id="@id/webView"
                android:background="@android:color/transparent"
                android:visibility="invisible"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" />
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/loadingContainer"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <com.github.ybq.android.spinkit.SpinKitView
                    android:id="@id/spinKit"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    app:SpinKit_Color="@color/color_365eee"
                    style="@style/SpinKitView.FadingCircle" />
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="@color/color_666666"
                    android:id="@id/tvLoadingMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dip"
                    android:text="@string/captcha_loading" />
                <TextView
                    android:textSize="13.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@id/tvRetry"
                    android:background="@drawable/shape_16dp_365eee"
                    android:paddingTop="8.0dip"
                    android:paddingBottom="8.0dip"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:minWidth="88.0dip"
                    android:text="@string/captcha_retry"
                    android:paddingStart="18.0dip"
                    android:paddingEnd="18.0dip" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>