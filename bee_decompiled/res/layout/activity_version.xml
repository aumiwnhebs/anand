<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/color_f5f8fe"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.mm.bee.pay.view.bar.TitleBar
        android:id="@id/titleBar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:barBackground="@color/color_f5f8fe" />
    <ImageView
        android:layout_width="120.0dip"
        android:layout_height="120.0dip"
        android:layout_marginTop="70.0dip"
        android:src="@mipmap/ic_logo" />
    <ImageView
        android:layout_width="130.0dip"
        android:layout_height="39.0dip"
        android:layout_marginTop="16.0dip"
        android:src="@mipmap/ic_pay_bee" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip">
        <TextView
            android:textSize="15.0sp"
            android:textColor="@color/color_666666"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_version" />
        <TextView
            android:textSize="15.0sp"
            android:textColor="@color/color_666666"
            android:id="@id/tvVersionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3.0dip" />
    </LinearLayout>
</LinearLayout>