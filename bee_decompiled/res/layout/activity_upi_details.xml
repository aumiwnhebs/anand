<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@color/color_f5f8fe"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.mm.bee.pay.view.bar.TitleBar
        android:id="@id/titleBar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:barText="@string/upi_details_title" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/llBottomBtn"
        android:layout_below="@id/titleBar">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@drawable/shape_16dp_ffffff"
                android:paddingTop="25.0dip"
                android:paddingBottom="25.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15.0dip">
                <ImageView
                    android:id="@id/ivLogo"
                    android:layout_width="87.0dip"
                    android:layout_height="87.0dip" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.0dip">
                    <TextView
                        android:textSize="16.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:textSize="10.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_06c56d"
                        android:gravity="center"
                        android:id="@id/tvLabelSell"
                        android:background="@drawable/shape_6dp_daf7e9_line_9ae7c4"
                        android:visibility="gone"
                        android:layout_width="26.0dip"
                        android:layout_height="15.0dip"
                        android:text="@string/sell"
                        android:layout_marginStart="4.0dip" />
                    <TextView
                        android:textSize="10.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_fa5c8c"
                        android:gravity="center"
                        android:id="@id/tvLabelBuy"
                        android:background="@drawable/shape_6dp_fee0e9_line_fbaac3"
                        android:visibility="gone"
                        android:layout_width="26.0dip"
                        android:layout_height="15.0dip"
                        android:text="@string/buy"
                        android:layout_marginStart="4.0dip" />
                </LinearLayout>
                <View
                    android:background="@drawable/shape_dashed_horizontal_line_6000000"
                    android:layout_width="fill_parent"
                    android:layout_height="2.0dip"
                    android:layout_marginTop="20.0dip"
                    android:layout_marginBottom="20.0dip" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5.0dip"
                    android:layout_marginEnd="12.0dip">
                    <TextView
                        android:textSize="14.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_999999"
                        android:gravity="end"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/upi_details_name"
                        android:layout_weight="0.7"
                        android:layout_marginEnd="8.0dip" />
                    <TextView
                        android:textSize="15.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_333333"
                        android:ellipsize="end"
                        android:id="@id/tvUpiName"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15.0dip"
                    android:layout_marginStart="5.0dip"
                    android:layout_marginEnd="12.0dip">
                    <TextView
                        android:textSize="14.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_999999"
                        android:gravity="end"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/upi_details_phone"
                        android:layout_weight="0.7"
                        android:layout_marginEnd="8.0dip" />
                    <TextView
                        android:textSize="15.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_333333"
                        android:ellipsize="end"
                        android:id="@id/tvUpiPhone"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15.0dip"
                    android:layout_marginStart="5.0dip"
                    android:layout_marginEnd="12.0dip">
                    <TextView
                        android:textSize="14.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_999999"
                        android:gravity="end"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/upi_details_status"
                        android:layout_weight="0.7"
                        android:layout_marginEnd="8.0dip" />
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">
                        <TextView
                            android:textSize="12.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_597bf7"
                            android:gravity="center"
                            android:id="@id/tvStatus"
                            android:background="@drawable/shape_6dp_e7ecff"
                            android:paddingTop="3.0dip"
                            android:paddingBottom="3.0dip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:paddingStart="8.0dip"
                            android:paddingEnd="8.0dip" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/llBottomBtn"
        android:layout_width="fill_parent"
        android:layout_height="45.0dip"
        android:layout_marginTop="10.0dip"
        android:layout_marginBottom="15.0dip"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="15.0dip"
        android:layout_marginEnd="15.0dip">
        <TextView
            android:textSize="16.0sp"
            android:textStyle="bold"
            android:textColor="@color/color_666666"
            android:gravity="center"
            android:id="@id/tvAuthorizeCancel"
            android:background="@drawable/shape_16dp_line_d6d6d6"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="45.0dip"
            android:text="@string/upi_details_unlink"
            android:layout_weight="0.6"
            android:layout_marginEnd="11.0dip" />
        <TextView
            android:textSize="16.0sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@id/tvAuthorize"
            android:background="@drawable/shape_16dp_365eee"
            android:layout_width="0.0dip"
            android:layout_height="45.0dip"
            android:text="@string/upi_details_reconnect"
            android:layout_weight="1.0" />
    </LinearLayout>
</RelativeLayout>