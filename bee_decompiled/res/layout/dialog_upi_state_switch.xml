<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/shape_28_gradient_b5e8fd_f5f8fe"
        android:paddingTop="19.0dip"
        android:paddingBottom="25.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15.0dip"
        android:paddingEnd="15.0dip"
        android:layout_marginStart="24.0dip"
        android:layout_marginEnd="24.0dip">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@id/ivSwitchImg"
            android:layout_width="134.0dip"
            android:layout_height="134.0dip"
            android:src="@mipmap/ic_upi_switch_on" />
        <TextView
            android:textSize="18.0sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-15.0dip"
            android:text="@string/upi_sell_enable_title" />
        <androidx.cardview.widget.CardView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15.0dip"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16.0dip"
            app:cardElevation="2.0dip"
            app:cardUseCompatPadding="true">
            <LinearLayout
                android:orientation="vertical"
                android:padding="24.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@id/ivLogo"
                        android:layout_width="36.0dip"
                        android:layout_height="36.0dip" />
                    <TextView
                        android:textSize="16.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8.0dip" />
                </LinearLayout>
                <TextView
                    android:textSize="12.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_6c707e"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.0dip"
                    android:text="@string/author_upi_authorize_vpa" />
                <TextView
                    android:textSize="16.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:ellipsize="end"
                    android:id="@id/tvUpi"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:maxLines="1" />
                <View
                    android:background="@color/color_eef2f6"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0dip"
                    android:layout_marginVertical="12.0dip" />
                <TextView
                    android:textSize="12.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_6c707e"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_phone" />
                <TextView
                    android:textSize="16.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:ellipsize="end"
                    android:id="@id/tvPhone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:maxLines="1" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="45.0dip"
            android:layout_marginTop="24.0dip">
            <TextView
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="@color/color_666666"
                android:gravity="center"
                android:id="@id/tvCancel"
                android:background="@drawable/shape_16dp_line_d6d6d6"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text="@string/cancel"
                android:layout_weight="1.0" />
            <TextView
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/tvConfirm"
                android:background="@drawable/shape_16dp_365eee"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text="@string/upi_sell_enable_yes"
                android:layout_weight="1.0"
                android:layout_marginStart="11.0dip" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>