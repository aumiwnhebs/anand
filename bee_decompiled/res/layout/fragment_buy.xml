<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ImageView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_top_bg"
            android:scaleType="fitXY" />
        <RelativeLayout
            android:id="@id/rlTitle"
            android:layout_width="fill_parent"
            android:layout_height="50.0dip"
            android:layout_marginTop="@dimen/dp_bar_top">
            <net.lucode.hackware.magicindicator.MagicIndicator
                android:layout_gravity="center_horizontal"
                android:id="@id/magicIndicator"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginStart="30.0dip"
                android:layout_marginEnd="30.0dip"
                android:layout_toStartOf="@id/tvBuyHistory" />
            <TextView
                android:textSize="12.0sp"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:gravity="center"
                android:id="@id/tvBuyHistory"
                android:background="@drawable/shape_25dp_line_20000000"
                android:paddingTop="7.0dip"
                android:paddingBottom="7.0dip"
                android:layout_width="100.0dip"
                android:layout_height="wrap_content"
                android:text="@string/buy_history_inr"
                android:layout_centerVertical="true"
                android:layout_marginEnd="13.0dip"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@id/viewPager"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_below="@id/rlTitle" />
    </RelativeLayout>
</LinearLayout>