<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@mipmap/ic_dialog_bg"
        android:padding="15.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15.0dip"
        android:layout_marginEnd="15.0dip">
        <TextView
            android:textSize="18.0sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5.0dip"
            android:text="@string/usdt_cancel_recharge_title" />
        <TextView
            android:textSize="15.0sp"
            android:textStyle="bold"
            android:textColor="@color/color_666666"
            android:gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25.0dip"
            android:text="@string/usdt_cancel_order_tip" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/llBottomBtn"
            android:layout_width="fill_parent"
            android:layout_height="45.0dip"
            android:layout_marginTop="30.0dip">
            <TextView
                android:textSize="13.0sp"
                android:textStyle="bold"
                android:textColor="@color/color_666666"
                android:gravity="center"
                android:id="@id/tvCancel"
                android:background="@drawable/shape_16dp_line_d6d6d6"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text="@string/usdt_cancel_anyway"
                android:layout_weight="1.0"
                android:layout_marginEnd="10.0dip" />
            <TextView
                android:textSize="13.0sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/tvNo"
                android:background="@drawable/shape_16dp_365eee"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text="@string/usdt_continue_recharge"
                android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>